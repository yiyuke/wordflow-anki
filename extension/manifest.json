{
  "manifest_version": 3,
  "name": "Wordflow to Anki",
  "version": "0.5.0",
  "description": "Capture selected English words with context and add AI-generated cards to Anki.",
  "permissions": ["contextMenus", "storage", "activeTab", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8766/*",
    "http://localhost:8766/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "打开 Wordflow 快速添加"
  },
  "commands": {
    "open-manual-input": {
      "suggested_key": {
        "default": "Alt+Shift+W",
        "mac": "Alt+Shift+W"
      },
      "description": "Open the manual word input"
    },
    "capture-selection": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "Add the selected word to Anki"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
