# Required unless MOCK_OPENAI=1
OPENAI_API_KEY=

# Efficient, high-volume GPT-5.6 model; override if your account uses another model.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.openai.com/v1

ANKI_CONNECT_URL=http://127.0.0.1:8765
ANKI_CONNECT_API_KEY=
ANKI_DECK=Vocabulary Inbox
ANKI_MODEL=AI Vocabulary

SERVER_HOST=127.0.0.1
SERVER_PORT=8766

# Optional pronunciation audio. IPA is generated even when this is off.
ENABLE_TTS=0
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Useful for local tests without network or Anki.
MOCK_OPENAI=0
MOCK_ANKI=0
